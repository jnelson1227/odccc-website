# Supabase — project "reedsport-chamber" (shared with the Visit Reedsport app)
NEXT_PUBLIC_SUPABASE_URL=https://xfvlpnlusypzqzoeyyoc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser. Used by the newsletter server action.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL — metadata, canonical links, sitemap, OG images.
# On Vercel you can leave this unset until the real domain is live: the build
# falls back to VERCEL_PROJECT_PRODUCTION_URL, so previews get correct URLs.
# Set it to https://oregonccc.com at cutover.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
